<?xml version="1.0" encoding="utf-8"?>
<!-- One car list row: min 64dp tall, huge text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/auto_raised"
    android:padding="20dp"
    android:layout_marginBottom="12dp">

    <TextView
        android:id="@+id/rowName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/auto_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rowMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/auto_text_muted"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/rowStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="#06251B"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
