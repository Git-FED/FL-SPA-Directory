<?xml version="1.0" encoding="utf-8"?>
<!-- Car screen: giant search field + giant list rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/auto_bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:text="@string/auto_title"
        android:textColor="@color/auto_accent"
        android:textSize="28sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/carSearch"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:hint="@string/auto_search_hint"
        android:inputType="text"
        android:maxLines="1"
        android:textSize="18sp"
        android:textColor="@color/auto_text"
        android:textColorHint="@color/auto_text_faint" />

    <TextView
        android:id="@+id/carCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="@color/auto_text_muted"
        android:textSize="16sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/carList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />
    </ScrollView>

    <TextView
        android:id="@+id/carEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/auto_empty"
        android:textColor="@color/auto_text_faint"
        android:textSize="18sp"
        android:visibility="gone" />

</LinearLayout>
