{
  "manifest_version": 3,
  "name": "FED-SPA - Licensed Spa Verification",
  "short_name": "FED-SPA",
  "version": "1.0.0",
  "description": "Verify Florida massage establishments against the state license database before you walk in. Includes a subscriber-only unlicensed watchlist.",
  "author": "FED-SPA contributors",
  "homepage_url": "https://github.com/YOUR_USERNAME/FED-SPA",
  "minimum_chrome_version": "88",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "FED-SPA - licensed spa check",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "*://mqa-internet.doh.state.fl.us/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://mqa-internet.doh.state.fl.us/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
